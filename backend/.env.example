[TEMPLATE]
# NutriCare AI Backend Environment Configuration
PORT=8000
MONGODB_URI=mongodb://localhost:27017
DB_NAME=nutricare_db

# Python RAG + ML service (backend/rag_service.py)
ML_SERVICE_URL=http://127.0.0.1:5000
# How long Node waits for a RAG answer (ms). Knowledge-base answers are
# instant; a local LLM on CPU can take a minute or more.
RAG_TIMEOUT_MS=120000

# --- RAG service settings ---
RAG_PORT=5000
# Leave CHROMA_PATH / CHROMA_COLLECTION empty to auto-discover the
# knowledge base built by RAG/create_database.py (RAG/chroma_db).
CHROMA_PATH=
CHROMA_COLLECTION=
# auto | ollama | openai | gemini | none
LLM_PROVIDER=auto
# Empty = first installed Ollama model (e.g. llama3.2:latest)
LLM_MODEL=
LLM_MAX_TOKENS=110
LLM_TIMEOUT=90
OLLAMA_URL=http://localhost:11434
OPENAI_API_KEY=
GEMINI_API_KEY=

# Admin Credentials
ADMIN_EMAIL=admin@nutricare.ai
ADMIN_PASSWORD=admin123

# Email OTP Service Options (Optional: OTP is always printed in backend terminal for easy testing)
# Option A: Resend API Key (Free 3,000 emails/mo at https://resend.com)
RESEND_API_KEY=

# Option B: Standard SMTP (e.g. Gmail with App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
